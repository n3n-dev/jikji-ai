# Copy to .env (ignored). Fill blank values; never commit the filled file.
GHOST_IMAGE=jikji-ghost:6.62.0
METRICS_IMAGE=jikji-blog-metrics:1
MYSQL_IMAGE=mysql:8.0
GHOST_URL=https://example.com/blog
GHOST_BIND_PORT=2368
METRICS_BIND_PORT=2369
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ghost
DB_USER=ghost
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Optional metrics overlay: public Ghost URL, without trailing slash on origin.
BLOG_ORIGIN=https://example.com
GHOST_CONTENT_API_KEY=
