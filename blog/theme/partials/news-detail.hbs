<article class="article article-news {{post_class}}">
  <header class="article-header"><a class="eyebrow" href="{{@site.url}}/news/">NEWS</a><p class="article-meta"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY년 MM월 DD일"}}</time></p><h1>{{title}}</h1>{{#if custom_excerpt}}<p class="lede">{{custom_excerpt}}</p>{{/if}}</header>
  <div class="article-layout">{{> "author-rail"}}<div class="article-main">{{> "article-content"}}
  <footer class="article-footer">{{tags separator=" "}}<a class="back-link" href="{{@site.url}}/news/">← News 목록</a></footer>
  {{> "read-next"}}
  </div><aside class="toc-rail" aria-label="이 글의 목차" hidden><p>이 글의 목차</p><nav class="article-toc"></nav></aside></div>
</article>
