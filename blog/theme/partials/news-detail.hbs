<article class="article article-news {{post_class}}">
  <header class="article-header"><span class="eyebrow">NEWS</span><h1>{{title}}</h1><p class="article-meta"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY.MM.DD"}}</time> {{> "article-views"}}</p></header>
  <div class="article-layout"><div class="article-main">{{> "article-content"}}
  <footer class="article-footer">{{!-- Tags are hidden until needed. Restore: {{tags separator=" "}} --}}{{> "article-actions" section="news" label="News"}}</footer>
  {{> "read-next"}}
  </div><aside class="toc-rail" aria-label="이 글의 목차" hidden><p>이 글의 목차</p><nav class="article-toc"></nav></aside></div>
</article>
