<article class="story-card {{post_class}}">
  {{#if feature_image}}
    <a class="card-image" href="{{url}}" tabindex="-1" aria-hidden="true">
      <img src="{{img_url feature_image size="medium"}}" srcset="{{img_url feature_image size="small"}} 480w, {{img_url feature_image size="medium"}} 800w" sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw" alt="" loading="lazy" width="800" height="500">
    </a>
  {{else}}
    <a class="card-image card-cover" href="{{url}}" tabindex="-1" aria-hidden="true"><span class="cover-brand">JIKJI Blog</span><span class="cover-symbol">{{#match primary_tag.slug "news"}}↗{{else}}✳{{/match}}</span><span class="cover-label">{{#match primary_tag.slug "news"}}What's next.{{else}}Our stories. Together.{{/match}}</span></a>
  {{/if}}
  <div class="card-meta"><span class="eyebrow">{{#match primary_tag.slug "news"}}News{{else}}{{#match primary_tag.slug "blog"}}Blog{{else}}Article{{/match}}{{/match}}</span></div>
  <h{{heading}} class="card-title"><a href="{{url}}">{{title}}</a></h{{heading}}>
  {{#match primary_tag.slug "news"}}{{else}}{{#match primary_tag.slug "blog"}}{{else}}
  <p class="card-excerpt">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt characters="180"}}{{/if}}</p>
  {{/match}}{{/match}}
  <p class="card-byline">{{#match primary_tag.slug "news"}}{{else}}{{authors separator=" / "}} <span aria-hidden="true">·</span> {{/match}}<time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY.MM.DD"}}</time></p>
</article>
