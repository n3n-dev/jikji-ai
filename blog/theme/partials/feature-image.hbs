{{#if feature_image}}<figure class="feature-image"><img src="{{img_url feature_image size="large"}}" srcset="{{img_url feature_image size="small"}} 480w, {{img_url feature_image size="medium"}} 800w, {{img_url feature_image size="large"}} 1600w" sizes="(min-width: 900px) 900px, 100vw" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">{{#if feature_image_caption}}<figcaption>{{{feature_image_caption}}}</figcaption>{{/if}}</figure>{{/if}}
