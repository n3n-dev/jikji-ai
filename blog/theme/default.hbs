<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{meta_title}}</title>
  <link rel="stylesheet" href="{{asset "css/screen.css"}}">
  <link rel="stylesheet" href="{{asset "css/tech.css"}}">
  <link rel="stylesheet" href="{{asset "css/company-nav.css"}}">
  <link rel="stylesheet" href="{{asset "css/faq.css"}}">
  <link rel="stylesheet" href="{{asset "css/company-footer.css"}}">
  {{ghost_head}}
</head>
<body class="{{body_class}}">
  <a class="skip-link" href="#main">본문으로 건너뛰기</a>
  <header class="company-header"><div class="company-header-inner">
    <a class="brand" href="{{> "company-url"}}/" aria-label="JIKJI 회사 홈페이지">
      {{> "brand"}}
    </a>
    {{> "company-nav"}}
    <button class="company-menu-toggle" aria-label="메뉴 열기" aria-expanded="false" aria-controls="company-navigation">☰</button>
  </div></header>
  <main id="main" class="shell" tabindex="-1">{{{body}}}</main>
  {{> "company-footer"}}
  {{#is "post, page"}}<script src="{{asset "js/faq.js"}}" defer></script>{{/is}}
  {{#is "post, page"}}<script src="{{asset "js/prism.js"}}" defer></script>{{/is}}
  <script src="{{asset "js/content.js"}}" defer></script>
  {{#is "post"}}<script src="{{asset "js/author-bio.js"}}" defer></script>{{/is}}
  {{#is "post"}}<script src="{{asset "js/views.js"}}" defer></script>{{/is}}
  <script src="{{asset "js/company-footer.js"}}" defer></script>
  {{ghost_foot}}
</body>
</html>
