{{!< default}}
{{#post}}
<article class="article {{post_class}}">
  {{#if @page.show_title_and_feature_image}}
    <header class="article-header"><h1>{{title}}</h1>{{#if custom_excerpt}}<p class="lede">{{custom_excerpt}}</p>{{/if}}</header>
    {{> "feature-image"}}
  {{/if}}
  <div class="gh-content">{{content}}</div>
</article>
{{/post}}
