{
  "name": "jikji-blog-workspace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "check:theme": "gscan theme --verbose",
    "package:theme": "node scripts/package-theme.mjs",
    "dev": "docker compose up -d",
    "dev:stop": "docker compose stop",
    "dev:logs": "docker compose logs --tail=80 ghost",
    "test:views": "node --test services/views/*.test.mjs",
    "test:author-bio": "node --test scripts/author-bio.test.mjs",
    "build:prism": "node scripts/build-prism.cjs"
  },
  "engines": {
    "node": "^22.17.0 || ^24.0.0"
  },
  "devDependencies": {
    "gscan": "6.5.0",
    "prismjs": "1.30.0"
  }
}
